"""
子图图卷积融合模型 - 仅位置预测版
改动：
1. 图卷积模块层数+1，隐藏维度增加到256
2. 移除尺寸预测相关模块，仅预测位置
3. 空间回归器融合位置回归功能
4. 增加血管段编码器深度（+1层）
5. 通过return_attention_map参数控制是否生成注意力图
"""

import torch
import torch.nn as nn
import torch.nn.functional as F
from typing import Tuple, Dict, List, Optional
import numpy as np


# ==================== 1. 子图提取模块 ====================

class SubImageExtractor(nn.Module):
    """
    子图提取模块
    输入: [B, 1, 512, 512]
    输出: [B, 256, 32, 32]
    """
    def __init__(self, patch_size=16, image_size=512):
        super().__init__()
        self.patch_size = patch_size
        self.grid_size = image_size // patch_size  # 32

    def forward(self, image):
        B, C, H, W = image.shape
        p = self.patch_size
        g = self.grid_size

        patches = image.unfold(2, p, p).unfold(3, p, p)
        patches = patches.contiguous().view(B, C, g * g, p, p).squeeze(1)
        sub_images = patches.view(B, g, g, p, p).permute(0, 3, 4, 1, 2).contiguous()
        sub_images = sub_images.view(B, p * p, g, g)

        return sub_images  # [B, 256, 32, 32]


class CompatiblePixelUnshuffle(nn.Module):
    """
    使用 PixelUnshuffle 实现与 SubImageExtractor 完全相同的输出
    输入: [B, 1, 512, 512]
    输出: [B, 256, 32, 32] (列优先顺序，与你的函数一致)
    """

    def __init__(self, patch_size=16, image_size=512):
        super().__init__()
        self.patch_size = patch_size
        self.grid_size = image_size // patch_size  # 32
        self.unshuffle = nn.PixelUnshuffle(downscale_factor=patch_size)

        channels = patch_size * patch_size  # 256
        row_major = torch.arange(channels).reshape(self.grid_size, self.grid_size)
        col_major = row_major.T  # 转置得到列优先
        self.register_buffer('reorder_indices', col_major.flatten())

    def forward(self, image):
        """
        Args:
            image: [B, 1, 512, 512]
        Returns:
            sub_images: [B, 256, 32, 32]
        """
        out = self.unshuffle(image)  # [B, 256, 32, 32] (行优先)

        out = out[:, self.reorder_indices, :, :]

        return out

# ==================== 2. 多尺度通道分离卷积 ====================

class SimpleIndependentDilatedConv(nn.Module):
    """
    独立的子图空洞卷积
    - groups=256 确保每个子图独立处理
    - 多尺度空洞率捕获不同感受野
    """
    def __init__(self, in_channels=256, out_channels=256, dilations=[1, 2, 4, 6], num_blocks=2):
        super().__init__()
        self.num_subimages = in_channels
        groups = self.num_subimages  # 256

        layers = []
        current_in = in_channels

        for _ in range(num_blocks):
            for d in dilations:
                layers.append(
                    nn.Sequential(
                        # Depthwise Separable Convolution
                        nn.Conv2d(current_in, current_in, kernel_size=3,
                                  padding=d, dilation=d, groups=groups, bias=False),
                        nn.BatchNorm2d(current_in),
                        nn.ReLU(inplace=True),
                        # Pointwise Convolution
                        nn.Conv2d(current_in, out_channels, kernel_size=1, groups=groups, bias=False),
                        nn.BatchNorm2d(out_channels),
                        nn.ReLU(inplace=True),
                    )
                )
                current_in = out_channels

        self.blocks = nn.Sequential(*layers)
        self.residual_weight = nn.Parameter(torch.tensor(0.1))

    def forward(self, x):
        identity = x
        x = self.blocks(x)
        return identity + self.residual_weight * x


# ==================== 3. 图节点编码器 ====================

class SubImageToGraphEncoder(nn.Module):
    """
    将子图特征转换为图节点特征
    输入: [B, 256, 32, 32]
    输出: [B, 1024, feature_dim] 节点特征, [1024, 2] 节点位置
    """
    def __init__(self, in_channels=256, feature_dim=128):
        super().__init__()

        self.node_encoder = nn.Sequential(
            nn.Linear(in_channels, feature_dim * 2),
            nn.BatchNorm1d(feature_dim * 2),
            nn.ReLU(inplace=True),
            nn.Dropout(0.1),
            nn.Linear(feature_dim * 2, feature_dim),
            nn.BatchNorm1d(feature_dim),
            nn.ReLU(inplace=True),
        )

        self.grid_size = 32

    def forward(self, sub_images):
        B, C, H, W = sub_images.shape
        N = H * W  # 1024
        self.grid_size = H

        # 重塑为 [B, N, C]
        node_input = sub_images.permute(0, 2, 3, 1).reshape(B, N, C)
        node_input_flat = node_input.reshape(B * N, C)

        # 编码
        node_features_flat = self.node_encoder(node_input_flat)
        node_features = node_features_flat.reshape(B, N, -1)

        # 生成节点位置（归一化坐标）
        positions = torch.zeros(N, 2, device=sub_images.device)
        for i in range(H):
            for j in range(W):
                idx = i * W + j
                positions[idx, 0] = (j + 0.5) / W
                positions[idx, 1] = (i + 0.5) / H

        return node_features, positions


# ==================== 4. 图卷积模块（增强版：层数+1，维度256）====================

class SubImageGraphConv(nn.Module):
    """
    子图图卷积 - 8邻域连接
    增强：层数+1（共3层），隐藏维度增加到256
    """
    def __init__(self, feature_dim=128, hidden_dim=256, out_dim=256):
        super().__init__()

        # 三层GCN
        self.gcn1 = nn.Linear(feature_dim, hidden_dim)
        self.gcn2 = nn.Linear(hidden_dim, hidden_dim)
        self.gcn3 = nn.Linear(hidden_dim, out_dim)

        self.norm1 = nn.LayerNorm(hidden_dim)
        self.norm2 = nn.LayerNorm(hidden_dim)
        self.norm3 = nn.LayerNorm(out_dim)

        self.dropout = nn.Dropout(0.1)

        self.register_buffer('adjacency', None)

    def _build_adjacency(self, grid_size, device):
        """构建8邻域邻接矩阵"""
        n = grid_size
        num_nodes = n * n
        adj = torch.eye(num_nodes, device=device)

        for i in range(n):
            for j in range(n):
                idx = i * n + j
                for di in [-1, 0, 1]:
                    for dj in [-1, 0, 1]:
                        if di == 0 and dj == 0:
                            continue
                        ni, nj = i + di, j + dj
                        if 0 <= ni < n and 0 <= nj < n:
                            adj[idx, ni * n + nj] = 1

        deg = adj.sum(dim=1)
        deg_inv_sqrt = deg.pow(-0.5)
        deg_inv_sqrt[deg_inv_sqrt == float('inf')] = 0
        adj_norm = deg_inv_sqrt.view(-1, 1) * adj * deg_inv_sqrt.view(1, -1)

        return adj_norm

    def forward(self, node_features, node_positions):
        B, N, F = node_features.shape
        grid_size = int(np.sqrt(N))

        if self.adjacency is None or self.adjacency.shape[0] != N:
            self.adjacency = self._build_adjacency(grid_size, node_features.device)

        adj = self.adjacency

        # 图卷积第一层
        h = torch.einsum('ij,bjd->bid', adj, node_features)
        h = self.gcn1(h)
        h = self.norm1(h)
        h = torch.relu(h)
        h = self.dropout(h)

        # 图卷积第二层
        h = torch.einsum('ij,bjd->bid', adj, h)
        h = self.gcn2(h)
        h = self.norm2(h)
        h = torch.relu(h)
        h = self.dropout(h)

        # 图卷积第三层
        h = torch.einsum('ij,bjd->bid', adj, h)
        h = self.gcn3(h)
        h = self.norm3(h)

        return h


# ==================== 5. 空间回归器（仅输出位置）====================

class SpatialPositionRegressor(nn.Module):
    """
    空间回归器 - 仅输出位置
    - 融合了原位置回归头的注意力机制
    - 增加血管段编码器深度（+1层：3层）
    - 使用血管段信息辅助位置预测
    """
    def __init__(self, node_dim=256, num_segments=6, hidden_dim=256):
        super().__init__()

        # 血管段编码器（深度+1：3层）
        self.segment_encoder = nn.Sequential(
            nn.Linear(num_segments, hidden_dim // 2),
            nn.ReLU(inplace=True),
            nn.Linear(hidden_dim // 2, hidden_dim),
            nn.ReLU(inplace=True),
            nn.Linear(hidden_dim, hidden_dim),
            nn.ReLU(inplace=True),
        )

        # 特征融合（节点特征 + 血管段特征）
        self.fusion = nn.Sequential(
            nn.Linear(node_dim + hidden_dim, hidden_dim),
            nn.ReLU(inplace=True),
            nn.Dropout(0.1),
            nn.Linear(hidden_dim, node_dim),
            nn.ReLU(inplace=True),
        )

        # 位置注意力机制
        self.position_attention = nn.Sequential(
            nn.Linear(node_dim, hidden_dim),
            nn.ReLU(inplace=True),
            nn.Linear(hidden_dim, hidden_dim // 2),
            nn.ReLU(inplace=True),
            nn.Linear(hidden_dim // 2, 1),
        )

    def forward(self, node_features, segment_onehot, node_positions):
        """
        Args:
            node_features: [B, N, node_dim]
            segment_onehot: [B, num_segments]
            node_positions: [N, 2] 节点位置坐标
        Returns:
            position: [B, 2] 预测位置 (x, y)
            attention_weights: [B, N] 注意力权重
        """
        B, N, D = node_features.shape

        # 1. 编码血管段信息
        segment_feat = self.segment_encoder(segment_onehot)  # [B, hidden_dim]

        # 2. 全局池化节点特征
        global_feat = node_features.mean(dim=1)  # [B, node_dim]

        # 3. 融合特征
        fused = torch.cat([global_feat, segment_feat], dim=1)  # [B, node_dim + hidden_dim]
        fused = self.fusion(fused)  # [B, node_dim]

        # 4. 将融合信息注入到每个节点（广播）
        fused_expanded = fused.unsqueeze(1).expand(-1, N, -1)  # [B, N, node_dim]
        enhanced_features = node_features + 0.1 * fused_expanded  # 残差连接

        # 5. 位置预测（通过注意力机制）
        attention_logits = self.position_attention(enhanced_features)  # [B, N, 1]
        attention_weights = F.softmax(attention_logits.squeeze(-1), dim=1)  # [B, N]
        position = torch.einsum('bn,nd->bd', attention_weights, node_positions)  # [B, 2]

        return position, attention_weights


# ==================== 6. 完整模型 ====================

class SubImageGraphFusionModel(nn.Module):

    def __init__(self,
                 image_size: int = 512,
                 patch_size: int = 16,
                 subimg_feature_dim: int = 128,
                 gcn_hidden_dim: int = 256,
                 gcn_out_dim: int = 256,
                 num_segments: int = 6,
                 dilations: List[int] = [1, 2, 4, 6],
                 num_dilated_blocks: int = 2,
                 regressor_hidden_dim: int = 256):
        super().__init__()

        self.image_size = image_size
        self.patch_size = patch_size
        self.grid_size = image_size // patch_size  # 32
        self.num_nodes = self.grid_size * self.grid_size  # 1024
        self.num_segments = num_segments

        # ========== 模块1: 子图提取 ==========
        self.sub_extractor = SubImageExtractor(patch_size, image_size)

        # ========== 模块2: 多尺度通道分离卷积 ==========
        self.multi_scale_conv = SimpleIndependentDilatedConv(
            in_channels=patch_size * patch_size,  # 256
            out_channels=patch_size * patch_size,  # 256
            dilations=dilations,
            num_blocks=num_dilated_blocks,
        )

        # ========== 模块3: 子图→图节点编码 ==========
        self.graph_encoder = SubImageToGraphEncoder(
            in_channels=patch_size * patch_size,  # 256
            feature_dim=subimg_feature_dim,
        )

        # ========== 模块4: 图卷积（增强版） ==========
        self.graph_conv = SubImageGraphConv(
            feature_dim=subimg_feature_dim,
            hidden_dim=gcn_hidden_dim,
            out_dim=gcn_out_dim,
        )

        # ========== 模块5: 空间回归器（仅输出位置） ==========
        self.spatial_regressor = SpatialPositionRegressor(
            node_dim=gcn_out_dim,
            num_segments=num_segments,
            hidden_dim=regressor_hidden_dim
        )

        self._init_weights()

        # 打印信息
        total_params = sum(p.numel() for p in self.parameters())
        print(f"\n{'=' * 60}")
        print(f"SubImageGraphFusionModel 初始化完成（仅位置预测版）")
        print(f"{'=' * 60}")
        print(f"图像尺寸: {image_size}×{image_size}")
        print(f"采样块尺寸: {patch_size}×{patch_size}")
        print(f"子图网格: {self.grid_size}×{self.grid_size} = {self.num_nodes}节点")
        print(f"空洞率: {dilations}, 块数: {num_dilated_blocks}")
        print(f"图卷积: {subimg_feature_dim}→{gcn_hidden_dim}→{gcn_out_dim} (3层)")
        print(f"模型参数量: {total_params / 1e6:.2f}M")
        print(f"{'=' * 60}\n")

    def _init_weights(self):
        for m in self.modules():
            if isinstance(m, (nn.Conv2d, nn.Linear)):
                nn.init.kaiming_normal_(m.weight, mode='fan_out', nonlinearity='relu')
                if m.bias is not None:
                    nn.init.constant_(m.bias, 0)
            elif isinstance(m, (nn.BatchNorm2d, nn.BatchNorm1d, nn.LayerNorm)):
                nn.init.constant_(m.weight, 1)
                nn.init.constant_(m.bias, 0)

    def _generate_attention_map(self, attention_weights: torch.Tensor) -> torch.Tensor:
        """
        将注意力权重转换为二维热力图

        Args:
            attention_weights: [B, N] 注意力权重
        Returns:
            attention_map: [B, 1, H, W] 注意力热力图
        """
        B, N = attention_weights.shape

        # 重塑为二维网格
        att_map = attention_weights.view(B, 1, self.grid_size, self.grid_size)  # [B, 1, 32, 32]

        # 上采样到图像尺寸
        att_map_resized = F.interpolate(
            att_map,
            size=(self.image_size, self.image_size),
            mode='bilinear',
            align_corners=False
        )  # [B, 1, 512, 512]

        # 归一化到[0, 1]
        att_map_min = att_map_resized.amin(dim=(2, 3), keepdim=True)
        att_map_max = att_map_resized.amax(dim=(2, 3), keepdim=True)
        att_map_normalized = (att_map_resized - att_map_min) / (att_map_max - att_map_min + 1e-8)

        return att_map_normalized

    def forward(self, image: torch.Tensor, segment_onehot: torch.Tensor,
                return_attention_map: bool = False) -> Dict[str, torch.Tensor]:
        """
        Args:
            image: [B, 1, 512, 512]
            segment_onehot: [B, num_segments]
            return_attention_map: 是否返回注意力图（训练时False，测试时True）
        Returns:
            Dict:
                - position: [B, 2] 预测位置
                - attention_weights: [B, N] 注意力权重
                - attention_map: [B, 1, H, W] 注意力热力图（仅当return_attention_map=True）
                - node_features: [B, N, D] 节点特征
        """
        # 步骤1: 子图提取
        sub_images = self.sub_extractor(image)  # [B, 256, 32, 32]

        # 步骤2: 多尺度通道分离卷积
        sub_images = self.multi_scale_conv(sub_images)  # [B, 256, 32, 32]

        # 步骤3: 图节点编码
        node_features, node_positions = self.graph_encoder(sub_images)  # [B, 1024, 128]

        # 步骤4: 图卷积
        node_features_gcn = self.graph_conv(node_features, node_positions)  # [B, 1024, 256]

        # 步骤5: 空间回归器（输出位置和注意力权重）
        position, attention_weights = self.spatial_regressor(
            node_features_gcn, segment_onehot, node_positions
        )

        outputs = {
            'position': position,                    # [B, 2] 预测位置
            'attention_weights': attention_weights,  # [B, N] 原始注意力权重
            'node_features': node_features_gcn,      # [B, N, D] 节点特征
        }

        # 仅在需要时生成注意力图（测试时）
        if return_attention_map:
            outputs['attention_map'] = self._generate_attention_map(attention_weights)

        return outputs


# ==================== 7. 损失函数（简化版：仅位置损失）====================

class SubImageGraphLoss(nn.Module):
    """
    损失函数 - 仅位置损失，支持MSE和L1独立权重
    """

    def __init__(self,
                 mse_weight: float = 1.0,
                 l1_weight: float = 1.0):
        """
        Args:
            mse_weight: MSE损失权重
            l1_weight: L1损失权重
        """
        super().__init__()
        self.mse_weight = mse_weight
        self.l1_weight = l1_weight
        self.mse = nn.MSELoss()
        self.l1 = nn.L1Loss()

    def forward(self, outputs: Dict[str, torch.Tensor],
                targets: Dict[str, torch.Tensor]) -> Tuple[torch.Tensor, Dict[str, float]]:
        """
        Args:
            outputs: 模型输出
                - position: [B, 2] 位置
            targets:
                - position: [B, 2] 真实位置
                - has_aneurysm: [B, 1]
        Returns:
            total_loss: 总损失
            loss_dict: 包含各项损失的字典
        """
        has_aneurysm = targets['has_aneurysm'].squeeze() > 0.5
        device = outputs['position'].device

        if has_aneurysm.sum() > 0:
            pred = outputs['position'][has_aneurysm]
            target = targets['position'][has_aneurysm]

            # 分别计算MSE和L1损失
            mse_loss = self.mse(pred, target)
            l1_loss = self.l1(pred, target)

            # 加权总损失
            total_loss = self.mse_weight * mse_loss + self.l1_weight * l1_loss
        else:
            mse_loss = torch.tensor(0.0, device=device)
            l1_loss = torch.tensor(0.0, device=device)
            total_loss = torch.tensor(0.0, device=device)

        loss_dict = {
            'total_loss': total_loss.item(),
            'mse_loss': mse_loss.item(),
            'l1_loss': l1_loss.item(),
            'position_loss': total_loss.item()  # 保持兼容性
        }

        return total_loss, loss_dict


