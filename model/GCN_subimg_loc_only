        patch_size=16,
        subimg_feature_dim=128,
        gcn_hidden_dim=256,
        gcn_out_dim=256,
        num_segments=6,
        dilations=[1, 2, 4, 6],
        num_dilated_blocks=2,
        regressor_hidden_dim=256
    ).to(device)

    batch_size = 2
    image = torch.randn(batch_size, 1, 512, 512).to(device)
    segment_onehot = F.one_hot(torch.randint(0, 6, (batch_size,)), num_classes=6).float().to(device)

    print("\n" + "=" * 60)
    print("训练模式（不生成注意力图）")
    print("=" * 60)
    with torch.no_grad():
        outputs_train = model(image, segment_onehot, return_attention_map=False)

    for key, value in outputs_train.items():
        if isinstance(value, torch.Tensor):
            print(f"  {key}: {value.shape}")

    print("\n" + "=" * 60)
    print("测试模式（生成注意力图）")
    print("=" * 60)
    with torch.no_grad():
        outputs_test = model(image, segment_onehot, return_attention_map=True)

    for key, value in outputs_test.items():
        if isinstance(value, torch.Tensor):
            print(f"  {key}: {value.shape}")

